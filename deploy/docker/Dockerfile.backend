# Multi-stage production build for RookSac C++ Engine and Backend API

# Stage 1: Build native C++ Engine
FROM ubuntu:24.04 AS engine-builder
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY CMakeLists.txt ./
COPY engine/ ./engine/
COPY docs/ ./docs/
RUN cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Release
RUN cmake --build build --target rooksac rooksac_bench

# Stage 2: Runtime environment using Astral uv for fast, reproducible dependency resolution
FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ENVIRONMENT=production \
    ENGINE_BINARY_PATH=/opt/rooksac/bin/rooksac \
    PATH="/opt/rooksac/.venv/bin:$PATH"

WORKDIR /opt/rooksac

# Security: Run as non-root user
RUN groupadd -r rooksac && useradd -r -g rooksac -s /bin/false rooksac

# Install uv from official astral distribution
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Install runtime dependencies via uv into a standalone virtualenv
COPY pyproject.toml uv.lock ./
RUN uv venv /opt/rooksac/.venv && \
    uv sync --frozen --no-dev

# Copy engine binary from builder
COPY --from=engine-builder --chown=rooksac:rooksac /app/build/rooksac /opt/rooksac/bin/rooksac
RUN chmod 755 /opt/rooksac/bin/rooksac

# Copy backend app and tools
COPY --chown=rooksac:rooksac app/backend/ ./app/backend/
COPY --chown=rooksac:rooksac tools/ ./tools/

# Set ownership of the runtime directory
RUN chown -R rooksac:rooksac /opt/rooksac

USER rooksac

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/health')" || exit 1

CMD ["uvicorn", "app.backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
