# Multi-stage production build for RookSac React TypeScript Frontend

# ==============================================================================
# Stage 1: Build client assets
# ==============================================================================
FROM node:22.14.0-alpine3.21 AS builder
WORKDIR /app

COPY app/frontend/package*.json ./
RUN npm ci

COPY app/frontend/ ./
RUN npm run build

# ==============================================================================
# Stage 2: Minimal static web server
# ==============================================================================
FROM nginx:1.27.4-alpine3.21-slim AS runtime

# Remove default nginx config and static assets
RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf

# Security: Non-root nginx execution setup
RUN touch /var/run/nginx.pid && \
    chown -R nginx:nginx /var/run/nginx.pid /var/cache/nginx /var/log/nginx

COPY deploy/docker/nginx.conf /etc/nginx/conf.d/rooksac.conf
COPY --from=builder --chown=nginx:nginx /app/dist /usr/share/nginx/html

USER nginx

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
