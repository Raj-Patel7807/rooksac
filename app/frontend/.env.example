# RookSac Frontend Environment Variables
#
# Copy this file to .env.local for local overrides, or configure these variables
# in the Vercel Project Dashboard (Settings > Environment Variables).
#
# NOTE: All variables prefixed with VITE_ are embedded into the client bundle at build time.
# NEVER place secret API keys, credentials, or private tokens here!

# Remote FastAPI backend HTTP endpoint (e.g. Render hosted backend)
# In local development, leave unset to use Vite's built-in proxy to http://127.0.0.1:8000
VITE_API_BASE_URL=https://rooksac-api.onrender.com/api/v1

# Remote FastAPI backend WebSocket endpoint
# If left unset, it is automatically derived from VITE_API_BASE_URL (http -> ws, https -> wss)
VITE_WS_BASE_URL=wss://rooksac-api.onrender.com/ws
